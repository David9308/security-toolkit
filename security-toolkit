package com.example.securitytoolkit.cleaner
import android.content.Context
import kotlinx.coroutines.Dispatchers; import kotlinx.coroutines.withContext; import java.io.File
data class CleanResult(val filesDeleted:Int,val bytesFreed:Long,val errors:Int){
    fun formatted():String{val mb=bytesFreed/1048576.0; return if(mb>=1)"%.1f MB".format(mb) else "%.1f KB".format(bytesFreed/1024.0)}
}
class CacheCleaner(private val ctx:Context){
    suspend fun cleanAll():CleanResult=withContext(Dispatchers.IO){
        var d=0;var b=0L;var e=0
        listOfNotNull(ctx.cacheDir,ctx.codeCacheDir,ctx.externalCacheDir).forEach{dir->
            dir.listFiles()?.forEach{f->val s=if(f.isFile)f.length()else 0; if(f.deleteRecursively()){d++;b+=s}else e++}
        }; CleanResult(d,b,e)
    }
    suspend fun scanSize():Long=withContext(Dispatchers.IO){
        listOfNotNull(ctx.cacheDir,ctx.codeCacheDir,ctx.externalCacheDir).sumOf{it.walkTopDown().filter{it.isFile}.sumOf{it.length()}}
    }
}
