package com.example.securitytoolkit.adblock
import android.content.Context;import kotlinx.coroutines.Dispatchers;import kotlinx.coroutines.withContext;import java.io.File;import java.net.URL
object HostBlocker{
    private val blocked=mutableSetOf<String>()
    private val embedded=listOf("doubleclick.net","googleadservices.com","googlesyndication.com","googletagservices.com","adservice.google.com","ads.youtube.com","ads.yahoo.com","ads.facebook.com","amazon-adsystem.com","unityads.unity3d.com","applovin.com","mopub.com","inmobi.com","startapp.com","chartboost.com","vungle.com","adcolony.com","appnext.com","ironsrc.com")
    private val urls=listOf("https://raw.githubusercontent.com/StevenBlack/hosts/master/hosts")
    suspend fun load(ctx:Context)=withContext(Dispatchers.IO){
        if(blocked.isEmpty())blocked.addAll(embedded)
        try{val f=File(ctx.filesDir,"hosts.txt");if(f.exists())f.readLines().forEach{if(it.contains("."))blocked.add(it)} }catch(_:Exception){}
        try{for(u in urls){try{URL(u).openConnection().apply{connectTimeout=8000;readTimeout=8000}.getInputStream().bufferedReader().readText().lines().forEach{line->
            if(line.startsWith("#")||line.isBlank())return@forEach
            val d=when{line.startsWith("||")->line.substring(2).substringBefore("^");line.contains("0.0.0.0")->line.substringAfter("0.0.0.0").trim().split(" ")[0];else->null}
            if(d!=null&&d.contains(".")&&!d.contains(" "))blocked.add(d.lowercase())
        }}catch(_:Exception){}}
            File(ctx.filesDir,"hosts.txt").writeText(blocked.take(100000).joinToString("\n"))
        }catch(_:Exception){}
    }
    fun isBlocked(domain:String):Boolean{val c=domain.lowercase().trimEnd('.');return blocked.any{c==it||c.endsWith(".$it")}}
}
