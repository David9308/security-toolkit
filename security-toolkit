**`adblock/DnsPacket.kt`** - corazón del VPN
```kotlin
package com.example.securitytoolkit.adblock
object DnsPacket{
    data class Ipv4Info(val srcIp:ByteArray,val dstIp:ByteArray,val srcPort:Int,val dnsPayload:ByteArray)
    fun parse(p:ByteArray,len:Int):Ipv4Info?{
        try{
            if(len<20)return null; if((p[0].toInt() shr 4)!=4)return null
            val ihl=(p[0].toInt() and 0x0F)*4; if(len<ihl+8)return null; if(p[9].toInt() and 0xFF!=17)return null
            val total=((p[2].toInt() and 0xFF)shl 8)or(p[3].toInt() and 0xFF); if(total>len)return null
            val us=ihl; val sp=((p[us].toInt() and 0xFF)shl 8)or(p[us+1].toInt() and 0xFF)
            val dp=((p[us+2].toInt() and 0xFF)shl 8)or(p[us+3].toInt() and 0xFF); if(dp!=53)return null
            val ds=us+8; val dl=total-ds; if(dl<=12)return null
            return Ipv4Info(p.copyOfRange(12,16),p.copyOfRange(16,20),sp,p.copyOfRange(ds,ds+dl))
        }catch(_:Exception){return null}
    }
    fun getDomainName(dns:ByteArray):String?{try{var pos=12;val sb=StringBuilder();while(pos<dns.size){val l=dns[pos].toInt() and 0xFF;if(l==0)break;if(sb.isNotEmpty())sb.append(".");sb.append(String(dns,pos+1,l));pos+=l+1};return sb.toString()}catch(_:Exception){return null}}
    fun createBlockedResponse(q:ByteArray):ByteArray{
        var pos=12;while(pos<q.size&&q[pos].toInt()!=0){pos+=(q[pos].toInt() and 0xFF)+1};pos+=5;if(pos>q.size)pos=q.size
        val ql=pos-12;val r=ByteArray(12+ql);r[0]=q[0];r[1]=q[1];r[2]=0x81.toByte();r[3]=0x83.toByte();r[5]=1;System.arraycopy(q,12,r,12,ql);return r
    }
    fun buildResponseIpPacket(orig:ByteArray,origLen:Int,dnsResp:ByteArray):ByteArray?{
        try{
            val info=parse(orig,origLen)?:return null
            val total=20+8+dnsResp.size;val out=ByteArray(total)
            out[0]=0x45;out[2]=(total shr 8).toByte();out[3]=total.toByte();out[4]=orig[4];out[5]=orig[5];out[6]=0x40;out[8]=64;out[9]=17
            System.arraycopy(info.dstIp,0,out,12,4);System.arraycopy(info.srcIp,0,out,16,4)
            val cs=checksum(out,20);out[10]=(cs.toInt() shr 8).toByte();out[11]=cs.toByte()
            out[20]=0;out[21]=53;out[22]=(info.srcPort shr 8).toByte();out[23]=info.srcPort.toByte()
            val ul=8+dnsResp.size;out[24]=(ul shr 8).toByte();out[25]=ul.toByte()
            System.arraycopy(dnsResp,0,out,28,dnsResp.size);return out
        }catch(_:Exception){return null}
    }
    private fun checksum(h:ByteArray,len:Int):Short{var s=0;var i=0;while(i<len){s+=((h[i].toInt() and 0xFF)shl 8)or(h[i+1].toInt() and 0xFF);i+=2};while((s shr 16)!=0)s=(s and 0xFFFF)+(s shr 16);return (s.inv() and 0xFFFF).toShort()}
}
