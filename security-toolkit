**`adblock/AdBlockVpnService.kt`**
```kotlin
package com.example.securitytoolkit.adblock
import android.app.*;import android.content.Intent;import android.content.pm.ServiceInfo;import android.net.VpnService;import android.os.*;import androidx.core.app.NotificationCompat
import kotlinx.coroutines.*;import java.io.*;import java.net.*
class AdBlockVpnService:VpnService(){
    companion object{var isRunning=false;var blockedCount=0;const val ACTION_STOP="STOP"}
    private var tun:ParcelFileDescriptor?=null;private var job:Job?=null
    private val scope=CoroutineScope(Dispatchers.IO+SupervisorJob())
    override fun onStartCommand(i:Intent?,f:Int,s:Int):Int{
        if(i?.action==ACTION_STOP){stopSelf();return START_NOT_STICKY}
        startFg();startVpn();return START_STICKY
    }
    private fun startFg(){
        val id="adblock";if(Build.VERSION.SDK_INT>=26)getSystemService(NotificationManager::class.java).createNotificationChannel(NotificationChannel(id,"AdBlock",NotificationManager.IMPORTANCE_LOW))
        val stop=PendingIntent.getService(this,0,Intent(this,AdBlockVpnService::class.java).setAction(ACTION_STOP),PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
        val n=NotificationCompat.Builder(this,id).setContentTitle("🛡️ AdBlock Activo").setContentText("Bloqueados: $blockedCount").setSmallIcon(android.R.drawable.ic_menu_block).setOngoing(true).addAction(0,"Detener",stop).build()
        if(Build.VERSION.SDK_INT>=34)startForeground(1,n,ServiceInfo.FOREGROUND_SERVICE_TYPE_SPECIAL_USE)else startForeground(1,n)
    }
    private fun updateNotif(){try{val m=getSystemService(NotificationManager::class.java);val n=NotificationCompat.Builder(this,"adblock").setContentTitle("🛡️ AdBlock Activo").setContentText("Bloqueados: $blockedCount | DNS filtrado").setSmallIcon(android.R.drawable.ic_menu_block).setOngoing(true).build();m.notify(1,n)}catch(_:Exception){}}
    private fun startVpn(){
        if(isRunning)return
        try{
            tun=Builder().addAddress("10.0.0.2",32).addDnsServer("10.0.0.3").addRoute("10.0.0.3",32).setSession("Toolkit AdBlock").setMtu(1500).establish()?:return
            isRunning=true;blockedCount=getSharedPreferences("adblock",MODE_PRIVATE).getInt("count",0)
            scope.launch{HostBlocker.load(applicationContext)};job=scope.launch{vpnLoop()};updateNotif()
        }catch(e:Exception){e.printStackTrace()}
    }
    private suspend fun vpnLoop()=withContext(Dispatchers.IO){
        val fd=tun?:return@withContext;val input=FileInputStream(fd.fileDescriptor);val output=FileOutputStream(fd.fileDescriptor)
        val buf=ByteArray(2048);val lock=Any()
        try{while(isActive){val len=try{input.read(buf)}catch(_:Exception){break};if(len<=0)continue;val copy=buf.copyOf(len)
            launch{try{
                val info=DnsPacket.parse(copy,len)?:return@launch
                val dom=DnsPacket.getDomainName(info.dnsPayload)?:return@launch
                if(HostBlocker.isBlocked(dom)){blockedCount++;if(blockedCount%5==0){getSharedPreferences("adblock",MODE_PRIVATE).edit().putInt("count",blockedCount).apply();updateNotif()}
                    val r=DnsPacket.createBlockedResponse(info.dnsPayload);val ip=DnsPacket.buildResponseIpPacket(copy,len,r)?:return@launch;synchronized(lock){output.write(ip)}}
                else{val up=forward(info.dnsPayload)?:return@launch;val ip=DnsPacket.buildResponseIpPacket(copy,len,up)?:return@launch;synchronized(lock){output.write(ip)}}
            }catch(_:Exception){}}
        }}catch(_:Exception){}
    }
    private fun forward(q:ByteArray):ByteArray?{
        for(dns in listOf("1.1.1.1","8.8.8.8")){try{DatagramSocket().use{s->protect(s);s.soTimeout=3000;s.send(DatagramPacket(q,q.size,InetAddress.getByName(dns),53));val b=ByteArray(2048);val p=DatagramPacket(b,b.size);s.receive(p);return p.data.copyOf(p.length)}}}catch(_:Exception){}}
        return null
    }
    override fun onDestroy(){job?.cancel();scope.cancel();try{tun?.close()}catch(_:Exception){};isRunning=false;getSharedPreferences("adblock",MODE_PRIVATE).edit().putInt("count",blockedCount).apply();super.onDestroy()}
}
